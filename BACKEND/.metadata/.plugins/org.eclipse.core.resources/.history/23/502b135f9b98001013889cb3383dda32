package com.myproject.cicd.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.myproject.cicd.model.Ac;
import com.myproject.cicd.repository.AcRepository;

@Service
public class AcServiceImpl implements AcService {

    @Autowired
    private AcRepository repository;

    @Override
    public String addac(Ac a) {
        repository.save(a);
        return "Ac added successfully";
    }

    @Override
    public String deleteac(int aid) {
        Optional<Ac> object = repository.findById(aid);
        if (object.isPresent()) {
            repository.delete(object.get());
            return "Ac deleted successfully";
        } else {
            return "Ac Id not found";
        }
    }

    @Override
    public List<Ac> viewallacs() {
        return repository.findAll();
    }

    @Override
    public Ac viewacbyid(int id) {
        return repository.findById(id).orElse(null);
    }

    @Override
    public String updateac(int id, Ac updatedAc) {
        Optional<Ac> object = repository.findById(id);
        if (object.isPresent()) {
            Ac existingAc = object.get();
            existingAc.setBrand(updatedAc.getBrand());
            existingAc.setSerialNumber(updatedAc.getSerialNumber());
            existingAc.setPrice(updatedAc.getPrice());
            existingAc.setColor(updatedAc.getColor());
            repository.save(existingAc);
            return "Ac updated successfully";
        } else {
            return "Ac Id not found";
        }
    }
}
