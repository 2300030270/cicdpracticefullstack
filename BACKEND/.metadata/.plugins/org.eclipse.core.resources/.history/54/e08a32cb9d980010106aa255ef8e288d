package com.myproject.cicd.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

import com.myproject.cicd.model.Ac;
import com.myproject.cicd.service.AcService;

@RestController
@CrossOrigin("*")  // Allow all origins
@RequestMapping("/springbootacapi") // optional, if you want a base path
public class AcController {

    @Autowired
    private AcService service;

    // Home endpoint
    @GetMapping("/")
    public String home() {
        return "CI/CD FULLSTACK AC";
    }

    // Add AC
    @PostMapping("/add")
    public String addAc(@RequestBody Ac a) {
        return service.addac(a);
    }

    // View all ACs
    @GetMapping("/viewall")
    public List<Ac> viewAllAcs() {
        return service.viewallacs();
    }

    // View AC by ID
    @GetMapping("/view/{id}")
    public Ac viewAcById(@PathVariable int id) {
        return service.viewacbyid(id);
    }

    // Update AC
    @PutMapping("/update/{id}")
    public String updateAc(@PathVariable int id, @RequestBody Ac updatedAc) {
        return service.updateac(id, updatedAc);
    }

    // Delete AC
    @DeleteMapping("/delete/{id}")
    public String deleteAc(@PathVariable int id) {
        return service.deleteac(id);
    }
}
