@Override
public String updateac(int id) {
    Optional<Ac> object = repository.findById(id);
    if (object.isPresent()) {
        Ac existingAc = object.get();

        // Example: update only one field
        existingAc.setStatus("UPDATED"); // assumes your Ac entity has a "status" field

        repository.save(existingAc);
        return "Ac updated successfully";
    } else {
        return "Ac Id Not Found To Update";
    }
}
