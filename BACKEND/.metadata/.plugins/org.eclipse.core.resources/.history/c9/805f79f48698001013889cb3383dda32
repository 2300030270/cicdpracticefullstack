package com.myproject.cicd.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.myproject.cicd.model.Ac;
import com.myproject.cicd.repository.AcRepository;

@Service
public class AcServiceImpl implements AcService {

    @Autowired
    private AcRepository repository;

    @Override
    public Ac addAc(Ac ac) {
        return repository.save(ac);
    }

    @Override
    public List<Ac> getAllAcs() {
        return repository.findAll();
    }

    @Override
    public Ac getAcById(int id) {
        Optional<Ac> opt = repository.findById(id);
        return opt.orElse(null);
    }

    @Override
    public Ac updateAc(Ac ac) {
        return repository.save(ac);  // works for both add & update
    }

    @Override
    public void deleteAcById(int id) {
        repository.deleteById(id);
    }
}
